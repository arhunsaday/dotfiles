                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["left_control", "left_option", "left_shift", "left_command"],
                                        "optional": ["any"]
                                    }
                                },
