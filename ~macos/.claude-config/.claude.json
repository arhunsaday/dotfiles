{
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-gradient.sh",
    "padding": 0
  },
  "mcpServers": {
    "mcp-atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "",
        "JIRA_PERSONAL_TOKEN": ""
      }
    },
    "doorjames": {
      "command": "node",
      "args": [
        "$HNOME/repos/doorjames-mcp/dist/index.js"
      ]
    },
    "figma-mcp-go": {
      "type": "stdio",
      "command": "node",
      "args": [
        "$HOME/Documents/Useful/figma-mcp-go/bin/run.js"
      ],
      "env": {}
    }
  }
}