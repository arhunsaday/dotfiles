# secrets.env — every API key, token and credential, in ONE file.
# (This is secrets.env.example, the tracked template; the live copy lives at
#  ~/.config/secrets.env, outside the repo, so nothing here can be committed.)
#
#   ./dotfiles.sh install   # creates the live copy from this template if missing
#   secrets edit            # open it, then reload the current shell automatically
#   secrets list            # names only, never values
#
# It is sourced by ~/.zshenv (zsh) and ~/.bashrc (bash), so scripts and
# non-interactive shells see these too. Keep it to plain `export NAME=value`
# lines — both shells read it, so no zsh-only syntax.
#
# Rule of thumb: if leaking it would ruin your afternoon, it goes here and
# nowhere else in this repo.

# --- AI shell assistant ------------------------------------------------------
# Powers `ai`, `fix`, `wtf` and Ctrl-G. See zsh/.config/zsh/ai-shell.zsh, or run
# `ai --status` to see which backend is actually being used.
# export OPENAI_API_KEY=sk-proj-...
# export ANTHROPIC_API_KEY=sk-ant-...
#
# Optional — auto-detect picks openai, then anthropic, then the `claude` CLI.
# export AI_PROVIDER=openai              # auto | openai | anthropic | claude-cli
# export AI_OPENAI_MODEL=gpt-6-luna      # gpt-6-sol / gpt-6-astra for harder work
# export AI_REASONING_EFFORT=none        # none|low|medium|high|xhigh|max

# --- ArgoCD ------------------------------------------------------------------
# export ARGOCD_AUTH_TOKEN=
# export ARGOCD_SERVER=
# export ARGOCD_OPTS='--grpc-web'

# --- Scaleway ----------------------------------------------------------------
# export SCW_ACCESS_KEY=
# export SCW_SECRET_KEY=
# export SCW_DEFAULT_ORGANIZATION_ID=
# export SCW_DEFAULT_PROJECT_ID=

# --- Misc --------------------------------------------------------------------
# export GOOGLE_MAPS_API_KEY=
